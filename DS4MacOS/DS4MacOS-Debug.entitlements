<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Debug build: sandbox disabled for easier local development and testing -->
    <key>com.apple.security.get-task-allow</key>
    <true/>

    <!-- File access: security-scoped bookmarks keep user-selected model/DSpark/KV paths readable across relaunches -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox is mandatory for Mac App Store distribution -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Network: listen on a port as a server (local LLM API service) -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Network: outbound access for downloading model files -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- File access: user-selected model files (granted via NSOpenPanel/NSSavePanel) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- File access: KV cache directory (~/.ds4/kvcache; needs Downloads or bookmarks) -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- File access: security-scoped bookmarks keep user-selected model/DSpark/KV paths readable across relaunches -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
</dict>
</plist>
